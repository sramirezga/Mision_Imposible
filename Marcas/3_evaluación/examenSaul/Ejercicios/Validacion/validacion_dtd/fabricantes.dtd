<!ELEMENT fabricantes (fabricante)+>
<!ELEMENT fabricante (fundador, pais, modelos)>
<!ATTLIST fabricante id CDATA #REQUIRED logo CDATA #REQUIRED>
<!ELEMENT fundador (#PCDATA)>
<!ATTLIST fundador desde CDATA #REQUIRED>
<!ELEMENT pais (#PCDATA)>
<!ELEMENT modelos (modelo+)>
